# Local-only demo defaults. Set the same control token in dashboard session settings if changed.
POSTGRES_PASSWORD=aagaah-local-demo
AAGAAH_CONTROL_TOKEN=local-demo-only
# Standalone development against your own database:
# AAGAAH_DATABASE_URL=postgresql+psycopg://aagaah:password@localhost:5432/aagaah
# AAGAAH_REDIS_URL=redis://localhost:6379/0
# Explicit local preview without persistent services:
# AAGAAH_DEMO_MEMORY=true
# AAGAAH_SCHEDULE=true
